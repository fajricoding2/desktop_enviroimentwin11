def apps_mtime():
    try:
        return os.path.getmtime("/usr/share/applications")
    except OSError:
        return 0

APPS_MTIME = {"t": apps_mtime()}

def hide_menu():
    if win.get_visible():
        win.hide()
        state["hid"] = time.time()

def show_menu():
    global APPS
    t = apps_mtime()
    if t != APPS_MTIME["t"]:
        APPS_MTIME["t"] = t
        APPS = load_apps()
    guard["seen"] = False
    guard["menu"] = False
    state["all"] = False
    entry.set_text("")
    refresh_recents()
    update()
    place()
    win.show()
    place()
    win.present()
    entry.grab_focus()
    GLib.timeout_add(300, refocus)

def toggle():
    if win.get_visible():
        hide_menu()
    elif time.time() - state.get("hid", 0) > 0.5:
        show_menu()

def on_usr1():
    toggle()
    return True

GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, on_usr1)

