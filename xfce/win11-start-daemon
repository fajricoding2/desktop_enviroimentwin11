# ---------- klik kanan aplikasi: Open / Create shortcut ----------
MK_SHORTCUT = os.path.expanduser("~/.local/bin/mk-shortcut")
APP_DIRS = ("~/.local/share/applications", "/usr/local/share/applications",
            "/usr/share/applications", "~/.local/share/flatpak/exports/share/applications",
            "/var/lib/flatpak/exports/share/applications")

def app_path(app):
    """File .desktop asal aplikasi ini (untuk diserahkan ke mk-shortcut)."""
    try:
        f = app.get_filename()
    except Exception:
        f = None
    if f:
        return f
    try:
        aid = app.get_id()
    except Exception:
        return None
    if not aid:
        return None
    for d in APP_DIRS:
        p = os.path.join(os.path.expanduser(d), aid)
        if os.path.exists(p):
            return p
    return aid

def shortcut_source(app):
    """Path yang diserahkan ke mk-shortcut.

    Kalau entri .desktop menunjuk AppImage, serahkan AppImage-nya: mk-shortcut
    lalu memilih entri .desktop terbaik (nama + ikon resmi) untuk AppImage itu,
    bukan entri appimage-*.desktop yang generik.
    """
    p = app_path(app)
    if not p or not p.endswith(".desktop"):
        return p
    try:
        lines = open(p, encoding="utf-8", errors="replace").read().splitlines()
    except OSError:
        return p
    val = next((l.split("=", 1)[1].strip() for l in lines if l.startswith("Exec=")), "")
    try:
        toks = shlex.split(val)
    except ValueError:
        toks = val.split()
    for t in toks:
        if t.startswith("%"):
            continue
        if os.path.isabs(t) and t.lower().endswith(".appimage") and os.path.exists(t):
            return t
        break
    return p

def create_shortcut(app):
    target = shortcut_source(app)
    if target:
        try:
            subprocess.Popen([MK_SHORTCUT, target])
        except Exception:
            pass
    quit_soon()

def app_menu(app, widget, ev=None):
    m = Gtk.Menu()
    guard["m"] = m
    mi = Gtk.MenuItem(label="Open")
    mi.connect("activate", lambda _m: run(app))
    m.append(mi)
    m.append(Gtk.SeparatorMenuItem())
    mi = Gtk.MenuItem(label="Create shortcut")
    mi.connect("activate", lambda _m: create_shortcut(app))
    m.append(mi)
    def done(*_a):
        guard["menu"] = False
        GLib.timeout_add(250, check_close)
    m.connect("deactivate", done)
    guard["menu"] = True
    m.show_all()
    m.popup_at_pointer(ev)

def right_click(w, ev, app):
    if ev.button != 3:
        return False
    app_menu(app, w, ev)
    return True

def on_active(w, _p):
    if w.is_active():
        guard["seen"] = True
    elif guard["seen"]:
        GLib.timeout_add(200, check_close)

