# ---------- daemon: satu proses tetap hidup, menu hanya di-show/hide ----------
SHOW = "--show" in sys.argv
PID = "/tmp/win11-start-daemon.pid"

def is_ours(pid):
    try:
        return b"win11-start-daemon" in open("/proc/%d/cmdline" % pid, "rb").read()
    except OSError:
        return False

try:
    old = int(open(PID).read().strip())
    if old != os.getpid() and is_ours(old):
        if SHOW:
            os.kill(old, signal.SIGUSR1)
        sys.exit(0)
except (OSError, ValueError):
    pass
open(PID, "w").write(str(os.getpid()))

def cleanup():
    try:
        os.remove(PID)
    except OSError:
        pass
atexit.register(cleanup)

# ---------- data ----------
def load_apps():
    seen, out = set(), []
    for a in Gio.AppInfo.get_all():
        try:
            if not a.should_show():
                continue
        except Exception:
            continue
        n = a.get_name()
        if not n or n.lower() in seen:
            continue
        seen.add(n.lower())
        out.append(a)
    out.sort(key=lambda a: a.get_name().lower())
    return out

APPS = load_apps()

def pinned_apps():
    res, ids = [], set()
    for did in PINNED:
        try:
            a = DesktopAppInfo.new(did)
        except TypeError:
            a = None
        if a and a.should_show() and a.get_id() not in ids:
            res.append(a)
            ids.add(a.get_id())
    for a in APPS:
        if len(res) >= 12:
            break
        if a.get_id() not in ids:
            res.append(a)
            ids.add(a.get_id())
    return res[:18]

def recents(n=6):
    out = []
    try:
        for i in Gtk.RecentManager.get_default().get_items():
            if i.get_uri().startswith("file://") and i.exists():
                out.append(i)
    except Exception:
        pass
    out.sort(key=lambda i: i.get_modified(), reverse=True)
    return out[:n]

def ago(ts):
    d = time.time() - ts
    if d < 3600:
        return "%dm ago" % max(1, int(d // 60))
    if d < 86400:
        return "%dh ago" % int(d // 3600)
    if d < 172800:
        return "Yesterday"
    return "%dd ago" % int(d // 86400)

def match(a, q):
    parts = [a.get_name() or "", a.get_description() or ""]
    try:
        parts.append(a.get_generic_name() or "")
        parts.append(" ".join(a.get_keywords() or []))
    except Exception:
        pass
    return q in " ".join(parts).lower()

def quit_soon():
    hide_menu()

def run(app):
    try:
        ctx = Gdk.Display.get_default().get_app_launch_context()
        app.launch([], ctx)
    except Exception:
        pass
    quit_soon()

def open_uri(uri):
    try:
        Gio.AppInfo.launch_default_for_uri(uri, None)
    except Exception:
        pass
    quit_soon()

def icon_of(gicon, size, fallback="application-x-executable"):
    img = Gtk.Image.new_from_gicon(gicon or Gio.ThemedIcon.new(fallback), Gtk.IconSize.DIALOG)
    img.set_pixel_size(size)
    return img

